CXX = c++

CXXFLAGS = -Wall -Wextra -Werror -std=c++98 -g3

NAME = Interface

SRCS = main.cpp \
	   MateriaSource.cpp \
	   Ice.cpp \
	   Cure.cpp \
	   Character.cpp \
	   AMateria.cpp


OBJS := $(SRCS:.cpp=.o)

all : $(NAME)

$(NAME): $(OBJS)
		$(CXX) $(CXXFLAGS) $(OBJS) -o $(NAME)
		rm -f vgcore.*

%.o: %.cpp
		$(CXX) $(CXXFLAGS) -c $< -o $@

clean:
		rm -f $(OBJS)

fclean: clean
		rm -f $(NAME)
		rm -f vgcore.*

re: fclean all

.PHONY: all clean fclean re